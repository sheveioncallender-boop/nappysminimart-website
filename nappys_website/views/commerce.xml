<?xml version='1.0' encoding='utf-8'?>
<odoo>
 <template id="departments" name="Nappy’s departments"><section class="nm-section nm-departments" data-snippet="s_text_block" data-name="Nappy’s Departments"><div class="nm-container"><div class="nm-section-heading"><div><span class="nm-eyebrow">A LITTLE OF WHAT YOU NEED</span><h2>Make your everyday<br/><em>a little easier.</em></h2></div><a href="/departments" class="nm-text-link">Explore departments</a></div><div class="nm-department-grid"><a t-att-href="website._nappys_category_url('category_pantry')" class="nm-department nm-reveal"><div class="nm-photo"><img src="/nappys_website/static/src/img/pantry.jpg" alt="Everyday pantry groceries on shelves" width="1600" height="1067" loading="lazy"/></div><div class="nm-department-copy"><span class="nm-eyebrow">FOR THE KITCHEN</span><h3>Pantry essentials</h3><p>The cupboard staples on your list.</p></div></a><a t-att-href="website._nappys_category_url('category_drinks')" class="nm-department nm-reveal"><div class="nm-photo"><img src="/nappys_website/static/src/img/drinks.jpg" alt="A selection of bottled drinks" width="1600" height="1067" loading="lazy"/></div><div class="nm-department-copy"><span class="nm-eyebrow">TAKE A BREAK</span><h3>Drinks and refreshment</h3><p>A little refreshment for your day.</p></div></a><a t-att-href="website._nappys_category_url('category_snacks')" class="nm-department nm-reveal"><div class="nm-photo"><img src="/nappys_website/static/src/img/snacks.jpg" alt="Chocolate chip cookies" width="1600" height="1067" loading="lazy"/></div><div class="nm-department-copy"><span class="nm-eyebrow">THE LITTLE EXTRAS</span><h3>Snacks and treats</h3><p>Something for the journey home.</p></div></a></div></div></section></template><template id="featured_products" name="Nappy’s Minimart live catalogue">
  <t t-set="nm_products" t-value="website._nappys_products()"/>
  <t t-set="nm_categories" t-value="website._nappys_categories()"/>
  <section t-if="nm_products" class="nm-section nm-products-section" contenteditable="false"><div class="nm-container">
   <t t-set="nm_prices" t-value="nm_products._get_sales_prices(website)"/>
   <div class="nm-section-heading"><div><span class="nm-eyebrow">FROM OUR SHELVES</span><h2>A few everyday <em>favourites.</em></h2></div><a href="/shop" class="nm-text-link">Shop all products </a></div>
   <nav t-if="nm_categories" class="nm-category-links" aria-label="Product categories"><a href="/shop">All products</a><a t-foreach="nm_categories" t-as="category" t-att-href="'/shop/category/' + website.env['ir.http']._slug(category)" t-out="category.name"/></nav>
   <div class="nm-product-grid"><article t-foreach="nm_products" t-as="product" class="nm-product">
    <a t-att-href="product.website_url" class="nm-product-photo"><img t-att-src="'/web/image/product.template/%s/image_512' % product.id" t-att-alt="product.name" width="512" height="512" loading="lazy"/><span class="nm-view-product">View product </span></a>
    <h3><a t-att-href="product.website_url" t-field="product.name"/></h3>
    <t t-set="price" t-value="nm_prices[product.id]"/>
    <div class="nm-price" t-if="not website.prevent_zero_price_sale or price['price_reduce']"><del t-if="price.get('base_price') and price['base_price'] &gt; price['price_reduce']"><span t-out="price['base_price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/></del><strong t-out="price['price_reduce']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/></div>
    <a t-else="" t-att-href="product.website_url" class="nm-text-link">Enquire about this item </a>
   </article></div>
  </div></section>
 </template>
 <template id="visit_banner" name="Visit Nappy’s"><section class="nm-visit-banner" data-snippet="s_text_block" data-name="Visit Nappy’s"><div class="nm-container"><div><span class="nm-eyebrow">RIGHT HERE IN YOUR COMMUNITY</span><h2>See you at <em>Nappy’s.</em></h2><p>Your everyday stop in La Romaine, Trinidad and Tobago.</p></div><div class="nm-visit-actions"><a class="nm-button nm-button-light" href="/visit-nappys">Plan your visit</a><t t-call="nappys_website.phone_link"/></div></div></section></template></odoo>
